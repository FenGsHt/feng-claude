{
  "name": "feng-claude",
  "productName": "Feng Claude",
  "version": "0.7.14",
  "description": "A third-party GUI wrapper for Claude Code CLI",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:renderer": "vite src/renderer --port 5173",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "rebuild": "npx @electron/rebuild -f -w node-pty",
    "build:root-exe": "node scripts/sync-root-exe.mjs",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "npm run build && electron-builder --mac",
    "build:linux": "npm run build && electron-builder --linux",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx"
  },
  "keywords": [
    "claude",
    "claude-code",
    "electron",
    "gui"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@electron-toolkit/utils": "^3.0.0",
    "@fontsource/dm-sans": "^5.2.8",
    "@fontsource/share-tech-mono": "^5.2.7",
    "@fontsource/vt323": "^5.2.7",
    "ansi-to-html": "^0.7.2",
    "chokidar": "^3.6.0",
    "electron-store": "^8.2.0",
    "electron-updater": "^6.8.3",
    "jszip": "^3.10.1",
    "mammoth": "^1.12.0",
    "node-pty": "^1.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "react-resizable-panels": "^4.10.0",
    "react-syntax-highlighter": "^15.5.0",
    "react-virtuoso": "^4.10.3",
    "remark-gfm": "^4.0.0",
    "uuid": "^10.0.0",
    "ws": "^8.20.0",
    "xlsx": "^0.18.5",
    "xterm": "^5.3.0",
    "xterm-addon-fit": "^0.8.0",
    "xterm-addon-web-links": "^0.9.0",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@electron/rebuild": "^4.0.4",
    "@types/node": "^20.14.8",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "electron": "^31.0.2",
    "electron-builder": "^24.13.3",
    "electron-rebuild": "^3.2.9",
    "electron-vite": "^2.3.0",
    "postcss": "^8.4.39",
    "tailwindcss": "^3.4.6",
    "typescript": "^5.5.2",
    "vite": "^5.3.1"
  }
}
